rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Jeder Nutzer darf nur sein eigenes Profil lesen/schreiben - aber die
    // ELO-Wertung darf nur die Cloud Function ändern, nicht der Client selbst
    // (sonst könnte man sich einfach eine Top-Wertung eintragen). Gleiches
    // gilt für hasPlayedRanked (steuert, ob das Deutsch-Level noch die
    // Start-Wertung setzen darf, siehe ROADMAP_QuizApp.md Abschnitt 18) -
    // sonst könnte man die eigene Wertung durch Neu-Angabe des Levels
    // manipulieren, nachdem man schon gewertete Matches gespielt hat.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eloRating', 'hasPlayedRanked']);
    }

    // Flottenrangliste: für alle lesbar, aber nur die Cloud Function (Admin
    // SDK, umgeht Regeln) darf den Punktestand ändern - Clients nicht.
    match /ships/{shipId} {
      allow read: if true;
      allow write: if false;

      match /seasons/{seasonKey} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Ergebnis-Einreichungen: jeder angemeldete Nutzer darf für sich selbst
    // einreichen (einmalig, nicht änderbar), aber nur eigene einsehen.
    match /scoreSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Karriere-Rangliste: für alle lesbar, nur die Cloud Function darf
    // schreiben.
    match /careerRankings/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // 1-vs-1-Warteschlange: jeder darf nur seinen eigenen Eintrag
    // lesen/schreiben (Wertung wird serverseitig aus users/{uid} gelesen,
    // hier also nichts Sicherheitsrelevantes zu schützen).
    match /careerQueue/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 1-vs-1-Matches: nur die beiden Teilnehmer dürfen lesen (für die
    // Live-Anzeige von Draft-Zügen/Rundenergebnissen); geschrieben wird nur
    // von den Cloud Functions (matchmakeCareerQueue, submitDraftAction,
    // submitRoundResult), nie direkt vom Client.
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow write: if false;
    }
  }
}
