rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vollwertiges Wettkampf-Konto (siehe ROADMAP_QuizApp.md Abschnitt 18h,
    // "Gestufter Zugang"): nicht anonym angemeldet, Crew-ID hinterlegt UND
    // Nickname + Position gesetzt (beide erscheinen in der Rangliste - ohne
    // sie entstünden leere Einträge). Wird für alles Wettbewerbsrelevante
    // verlangt (1 vs 1, Flottenkrieg-Einreichungen). Der get() kostet einen
    // Lesezugriff - nur auf den wenigen Schreibpfaden eingesetzt, nicht
    // flächendeckend (mehrfache get() derselben Doc werden zusammengefasst).
    function isFullAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isCompetitiveProfileComplete(
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isCompetitiveProfileComplete(d) {
      return d.get('crewIdHash', null) != null
        && d.get('nickname', '') is string && d.get('nickname', '').size() > 0
        && d.get('position', '') is string && d.get('position', '').size() > 0;
    }

    // Jeder Nutzer darf nur sein eigenes Profil lesen/schreiben - aber die
    // ELO-Wertung darf nur die Cloud Function ändern, nicht der Client selbst
    // (sonst könnte man sich einfach eine Top-Wertung eintragen). Gleiches
    // gilt für rankedMatchesPlayed (zählt Platzierungsmatches für den
    // K-Faktor, siehe ROADMAP_QuizApp.md Abschnitt 18b) - sonst könnte man
    // sich dauerhaft den höheren Platzierungs-K-Faktor erschleichen.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Beim Anlegen muessen die wettbewerbs-/sicherheitsrelevanten Felder auf
      // ihren Startwerten stehen - sonst koennte ein praeparierter Client sein
      // Profil direkt mit z. B. eloRating 5000 oder gesetztem crewIdHash
      // erzeugen. Setzen darf diese Felder danach nur noch die Cloud Function.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('eloRating', 1000) == 1000
        && request.resource.data.get('rankedMatchesPlayed', 0) == 0
        && request.resource.data.get('crewIdHash', null) == null
        && request.resource.data.get('crewId', null) == null
        && request.resource.data.get('firstName', null) == null
        && request.resource.data.get('nickname', null) == null
        && request.resource.data.get('firstNameChangedAt', null) == null
        && request.resource.data.get('nicknameChangedAt', null) == null;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny([
               'eloRating', 'rankedMatchesPlayed', 'crewId', 'crewIdHash',
               // Vorname/Nickname laufen wegen der 30-Tage-Sperrfrist nur über
               // die Cloud Function updateLockedNames (Abschnitt 18h Punkt 4).
               'firstName', 'firstNameChangedAt', 'nickname', 'nicknameChangedAt',
             ]);
    }

    // Crew-ID-Sperre (siehe ROADMAP_QuizApp.md Abschnitt 18h/18i): pro Crew-ID
    // (als HMAC-Hash) genau ein Eintrag, ausschließlich von der Cloud Function
    // claimCrewId geschrieben (Admin SDK, umgeht Regeln). Kein Client-Zugriff -
    // die Eindeutigkeitsprüfung läuft komplett serverseitig.
    match /crewIds/{hash} {
      allow read, write: if false;
    }

    // Flottenrangliste: für alle lesbar, aber nur die Cloud Function (Admin
    // SDK, umgeht Regeln) darf den Punktestand ändern - Clients nicht.
    match /ships/{shipId} {
      allow read: if true;
      allow write: if false;

      match /seasons/{seasonKey} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Ergebnis-Einreichungen für den Flottenkrieg: nur vollwertige Konten
    // dürfen einreichen (siehe ROADMAP_QuizApp.md Abschnitt 18h - der
    // Flottenkrieg ist wettbewerbsrelevant). Einmalig, nicht änderbar, nur
    // eigene einsehbar.
    match /scoreSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isFullAccount();
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Karriere-Rangliste: für alle lesbar, nur die Cloud Function darf
    // schreiben.
    match /careerRankings/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // 1-vs-1-Warteschlange: nur das eigene Dokument, und Schreiben (= ins
    // Matchmaking gehen) nur mit vollwertigem Konto (siehe ROADMAP_QuizApp.md
    // Abschnitt 18h). Lesen bleibt ohne die teure Prüfung - der eigene
    // Warteschlangen-Status ist nicht schützenswert.
    match /careerQueue/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isFullAccount();
    }

    // 1-vs-1-Matches: nur die beiden Teilnehmer dürfen lesen (für die
    // Live-Anzeige von Draft-Zügen/Rundenergebnissen); geschrieben wird nur
    // von den Cloud Functions (matchmakeCareerQueue, submitDraftAction,
    // submitRoundResult), nie direkt vom Client.
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow write: if false;
    }
  }
}
